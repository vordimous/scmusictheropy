# Copy this file to ".env" for local development with TinaCMS.
# Get these values from your Tina Cloud project at https://app.tina.io

# Public client ID for your Tina Cloud project
NEXT_PUBLIC_TINA_CLIENT_ID=

# Read-only content token from Tina Cloud
TINA_TOKEN=

# Git branch Tina reads/writes (this repo's default branch)
TINA_BRANCH=master
